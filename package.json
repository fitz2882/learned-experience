{
  "name": "learned-experience",
  "version": "0.4.0",
  "description": "Help AI coding agents avoid repeated mistakes, reuse proven fixes, and share practical lessons across sessions and tools. Local memory with automatic recall in supported hosts and recommendations informed by verified results.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "learned-experience": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets/logo.png",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "smoke": "npm run build && node scripts/smoke.mjs dist/index.js .learned-experience",
    "quality": "npm run build && node scripts/quality.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "ajv": "^8.20.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitz2882/learned-experience.git"
  },
  "homepage": "https://github.com/fitz2882/learned-experience#readme",
  "bugs": {
    "url": "https://github.com/fitz2882/learned-experience/issues"
  },
  "author": {
    "name": "fitz2882",
    "url": "https://github.com/fitz2882"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "experience",
    "self-improving",
    "agent",
    "claude",
    "hooks",
    "embeddings"
  ],
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "0.6.0"
    },
    "@huggingface/transformers": {
      "sharp": "0.35.0"
    }
  }
}
